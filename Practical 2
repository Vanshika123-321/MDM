        /* Reset and Base Styles */
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 0;
            background-color: #f4f7f6;
            color: #333;
        }

        /* Header Styling with Circular Image */
        header {
            background-color: #0056b3;
            color: #fff;
            padding: 30px 20px;
            text-align: center;
        }
        header h1 {
            margin: 10px 0 5px 0;
            font-size: 2.2rem;
        }
        header p {
            margin: 0 0 15px 0;
            font-size: 1.1rem;
            opacity: 0.9;
        }
        header img {
            width: 150px;          /* Width and height must be equal */
            height: 150px;         
            border-radius: 50%;    /* Makes the image a perfect circle */
            object-fit: cover;     /* Prevents distortion by cropping the center */
            border: 4px solid #fff;/* Elegant white border around the circle */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            margin-top: 10px;
        }

        /* Main Content Layout */
        main {
            max-width: 800px;
            margin: 20px auto;
            padding: 20px;
            background: #fff;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        section {
            margin-bottom: 30px;
            border-bottom: 1px solid #e0e0e0;
            padding-bottom: 20px;
        }
        section:last-child {
            border-bottom: none;
        }
        h2 {
            color: #0056b3;
            border-left: 4px solid #0056b3;
            padding-left: 10px;
            margin-top: 0;
        }

        /* Education Layout */
        .education-item {
            margin-bottom: 15px;
        }
        .duration {
            font-style: italic;
            color: #666;
            margin: 2px 0;
        }

        /* Footer */
        footer {
            text-align: center;
            padding: 20px;
            background-color: #333;
            color: #fff;
            margin-top: 20px;
        }
        footer a {
            color: #fff;
            text-decoration: underline;
        }
    </style>
</head>
